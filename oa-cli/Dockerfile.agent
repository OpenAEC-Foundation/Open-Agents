# Minimal Docker image for Claude CLI agents (D-040)
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install base tools + Node.js + Python3
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs npm python3 python3-pip curl git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Claude CLI via npm
RUN npm install -g @anthropic-ai/claude-code

# Working directory — agent workspace is mounted here
WORKDIR /workspace

# Volume mount points
VOLUME ["/workspace", "/project"]

# Default: run bash (overridden by spawn_agent command)
CMD ["bash"]
